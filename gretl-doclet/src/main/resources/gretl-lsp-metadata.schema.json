{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gretl.app/lsp/gretl-lsp-metadata.schema.json",
  "title": "GRETL LSP Metadata",
  "description": "Schema for gretl-lsp-metadata.json generated by gretl-doclet.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "gretlVersion", "source", "tasks"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Semantic version of the metadata schema."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 instant when the metadata was generated."
    },
    "gretlVersion": {
      "type": "string",
      "description": "GRETL version the metadata was extracted from."
    },
    "source": {
      "type": "object",
      "required": ["repository", "doclet"],
      "properties": {
        "repository": { "type": "string" },
        "doclet": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/definitions/TaskMetadata" }
    }
  },
  "definitions": {
    "TaskMetadata": {
      "type": "object",
      "required": ["name", "qualifiedClassName", "simpleClassName", "status", "description", "properties"],
      "properties": {
        "name": { "type": "string" },
        "qualifiedClassName": { "type": "string" },
        "simpleClassName": { "type": "string" },
        "category": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["stable", "incubating", "deprecated", "internal", "experimental"]
        },
        "description": { "type": "string" },
        "longDescription": { "type": "string" },
        "examples": {
          "type": "array",
          "items": { "$ref": "#/definitions/Example" }
        },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/definitions/PropertyMetadata" }
        }
      }
    },
    "Example": {
      "type": "object",
      "required": ["title", "language", "body"],
      "properties": {
        "title": { "type": "string" },
        "language": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    "PropertyMetadata": {
      "type": "object",
      "required": ["name", "kind", "valueType", "required", "description", "acceptedForms"],
      "properties": {
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["property", "dsl-method", "dsl-method-and-property", "gradle-inherited", "internal"]
        },
        "valueType": { "type": "string" },
        "javaType": { "type": "string" },
        "required": { "type": "boolean" },
        "deprecated": { "type": "boolean" },
        "description": { "type": "string" },
        "file": { "$ref": "#/definitions/FileMetadata" },
        "acceptedForms": {
          "type": "array",
          "items": { "$ref": "#/definitions/AcceptedForm" }
        },
        "migration": { "$ref": "#/definitions/MigrationMetadata" },
        "sqlParameterProvider": { "type": "boolean" },
        "completion": { "$ref": "#/definitions/CompletionMetadata" }
      }
    },
    "AcceptedForm": {
      "type": "object",
      "required": ["style", "signature", "insertText", "legacy"],
      "properties": {
        "style": {
          "type": "string",
          "enum": ["method-call", "assignment", "set-method", "unknown"]
        },
        "signature": { "type": "string" },
        "insertText": { "type": "string" },
        "argumentCount": { "type": "integer" },
        "legacy": { "type": "boolean" }
      }
    },
    "FileMetadata": {
      "type": "object",
      "required": ["role", "extensions"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["input", "output", "input-output", "directory-input", "directory-output", "unknown"]
        },
        "extensions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "multiple": { "type": "boolean" },
        "mustExist": { "type": "boolean" }
      }
    },
    "MigrationMetadata": {
      "type": "object",
      "required": ["from", "to", "codeActionTitle"],
      "properties": {
        "from": {
          "type": "array",
          "items": { "type": "string" }
        },
        "to": { "type": "string" },
        "codeActionTitle": { "type": "string" }
      }
    },
    "CompletionMetadata": {
      "type": "object",
      "required": ["label", "detail", "sortText"],
      "properties": {
        "label": { "type": "string" },
        "detail": { "type": "string" },
        "sortText": { "type": "string" }
      }
    }
  }
}
